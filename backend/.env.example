# backend/.env.example — 복사해서 backend/.env 로 쓴다 (.env 는 커밋 금지)

# PostgreSQL. Docker Compose 안에서는 host 를 서비스명(postgres)으로 바꾼다.
AILA_DATABASE_URL=postgresql+psycopg://aila:aila@localhost:5432/aila

# Fernet 대칭키. 연결 secret·LLM API 키 암호화에 쓴다.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AILA_ENCRYPTION_KEY=

# API
AILA_API_PREFIX=/api
AILA_CORS_ORIGINS=http://localhost:5173

# 조회 상한 (서버가 강제한다)
AILA_MAX_QUERY_RANGE_MINUTES=1440
AILA_MAX_LINES_PER_QUERY=5000
AILA_QUERY_TIMEOUT_SECONDS=30

# LLM
AILA_LLM_TIMEOUT_SECONDS=120
AILA_PROMPT_VERSION=v1
AILA_DEFAULT_DAILY_ANALYSIS_LIMIT=50
AILA_ANALYSIS_JOB_STALE_SECONDS=900

# error_samples 보존 기간 기본값
AILA_DEFAULT_SAMPLE_RETENTION_DAYS=30
