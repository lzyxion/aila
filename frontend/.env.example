# 백엔드 없이 화면만 확인할 때 true. fixture 데이터를 반환한다.
#
# Phase 3 부터 기본값은 false — 백엔드 전체가 구현되어 있고
# `docker compose --profile app up -d` 로 라이브 데이터가 뜨기 때문이다.
# 백엔드를 띄우지 않고 화면만 손볼 때만 true 로 되돌린다.
VITE_USE_MOCK=false

# mock 응답에 넣을 인위적 지연(ms). 로딩 상태 확인용.
VITE_MOCK_LATENCY_MS=250

# 백엔드 API 베이스. 비워두면 같은 오리진의 /api 를 쓰고 dev 서버가 프록시한다.
VITE_API_BASE=
