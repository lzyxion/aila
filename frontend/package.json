{
  "name": "aila-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AILA — Loki 기반 AI 로그 분석기 프론트엔드",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "vite build --ssr scripts/mock-smoke.ts --outDir .smoke --logLevel warn && node .smoke/mock-smoke.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
